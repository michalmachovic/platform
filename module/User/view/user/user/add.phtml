<h1>Add user</h1>

<?php if ($errors !== []): ?>
    <ul role="alert">
        <?php foreach ($errors as $error): ?>
            <li><?= htmlspecialchars($error, ENT_QUOTES, 'UTF-8') ?></li>
        <?php endforeach; ?>
    </ul>
<?php endif; ?>

<form action="<?= $this->url('user-add') ?>" method="post">
    <input type="hidden" name="csrf_token" value="<?= htmlspecialchars($csrfToken, ENT_QUOTES, 'UTF-8') ?>">

    <div>
        <label for="firstname">First name</label>
        <input
            id="firstname"
            name="firstname"
            type="text"
            maxlength="255"
            value="<?= htmlspecialchars($firstname, ENT_QUOTES, 'UTF-8') ?>"
            autocomplete="given-name"
            required
        >
    </div>

    <div>
        <label for="role_id">Role</label>
        <select id="role_id" name="role_id" required>
            <?php foreach ($roles as $role): ?>
                <option value="<?= $role['id'] ?>" <?= $roleId === $role['id'] ? 'selected' : '' ?>>
                    <?= htmlspecialchars($role['name'], ENT_QUOTES, 'UTF-8') ?>
                </option>
            <?php endforeach; ?>
        </select>
    </div>

    <div>
        <label for="lastname">Last name</label>
        <input
            id="lastname"
            name="lastname"
            type="text"
            maxlength="255"
            value="<?= htmlspecialchars($lastname, ENT_QUOTES, 'UTF-8') ?>"
            autocomplete="family-name"
            required
        >
    </div>

    <div>
        <label for="email">Email</label>
        <input
            id="email"
            name="email"
            type="email"
            maxlength="255"
            value="<?= htmlspecialchars($email, ENT_QUOTES, 'UTF-8') ?>"
            autocomplete="email"
            required
        >
    </div>

    <div>
        <label for="password">Password</label>
        <input
            id="password"
            name="password"
            type="password"
            minlength="8"
            autocomplete="new-password"
            required
        >
    </div>

    <button type="submit">Add user</button>
    <a href="<?= $this->url('user') ?>">Cancel</a>
</form>