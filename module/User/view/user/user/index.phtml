<h1>Users</h1>

<?php if (in_array($_SESSION['auth_role_name'] ?? '', ['admin', 'superadmin'], true)): ?>
    <p><a href="<?= $this->url('user-add') ?>">Add user</a></p>
<?php endif; ?>

<?php if (count($users) === 0): ?>
    <p>No users found.</p>
<?php else: ?>
    <ul>
        <?php foreach ($users as $user): ?>
            <?php $name = trim(($user->firstname ?? '') . ' ' . ($user->lastname ?? '')); ?>
            <li>
                <?= $name !== '' ? htmlspecialchars($name) . ' - ' : '' ?>
                <?= htmlspecialchars($user->email, ENT_QUOTES, 'UTF-8') ?>
                (<?= htmlspecialchars($roleNames[(int) $user->role_id] ?? 'user', ENT_QUOTES, 'UTF-8') ?>)
            </li>
        <?php endforeach; ?>
    </ul>
<?php endif; ?>